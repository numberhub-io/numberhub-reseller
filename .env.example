# The platform's own bot, where resellers create and manage their selling bots.
BUILDER_BOT_TOKEN=
# Telegram ids of the platform operators (comma-separated).
ADMIN_IDS=
# Fernet key that encrypts every reseller's bot token and API key at rest.
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
DB_URL=sqlite+aiosqlite:///./reseller.db
NUMBERHUB_API=https://api.numberhub.io/v1
# Markup a new bot starts with (the reseller changes it in their admin panel).
DEFAULT_MARKUP_PCT=30
